# settings/.env.secrets.template — variable NAMES contract for settings/.env.secrets.
# Values stay blank here (security rule: no literals in templates).
# Fill via `just secrets-pull` (Bitwarden) or `just secrets-reveal` (git-secret).
# Drift between this file and the live one is flagged by `just secrets-doctor`.

# Yandex Cloud
YC_TOKEN=
YC_CLOUD_ID=
YC_FOLDER_ID=
YC_SERVICE_ACCOUNT_KEY_FILE=

# Hetzner Cloud
HCLOUD_TOKEN=

# ClickHouse (course DWH)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Google (Sheets schedule reader — service-account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=

# LLM / deck tooling
PLUS_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram (deck publishing)
TELEGRAM_BOT_TOKEN=
