*.pptx filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.key filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# picstore — curated deck illustrations. PATH-SCOPED on purpose: a bare `*.png` rule
# would also claim the 72 pictures already tracked as plain blobs in data/source/media/,
# leaving the repo needing a `git lfs migrate`. Keep these globs anchored to data/images/.
data/images/**/*.png  filter=lfs diff=lfs merge=lfs -text
data/images/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
data/images/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
data/images/**/*.webp filter=lfs diff=lfs merge=lfs -text
data/images/**/*.gif  filter=lfs diff=lfs merge=lfs -text
# .svg stays plain git — it is text and diffs usefully.
# The catalog is a rebuildable index; catalog.xml (plain git) is the mergeable SSoT.
data/images/.picstore/catalog.sqlite filter=lfs diff=lfs merge=lfs -text
