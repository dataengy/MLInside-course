# Secrets — never commit
settings/.env.secrets
*.env.secrets
.env
.env.*
!.env.*.template

# OS / editor cruft
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
.venv/
.uv/

# NB: *.zip and data/source/ are TRACKED (git LFS) since the 2026-07-19 librarian move —
# data/source now holds the only copies of ingested originals.
data/generated/
# runtime scan cursor (publish-cursor.json)
data/.state/
.uv-cache/
uv.lock

# picstore: provider response + blob cache, and regenerable review artifacts.
# data/images/** and .picstore/catalog.{sqlite,xml} ARE tracked (see .gitattributes).
.picstore-cache/
data/images/.picstore/reports/

# preza-merge contact sheets: regenerable per-merge PNG/PDF (--contact-sheet), never source.
docs/reviews/merge/contact/

# .tmp/ dev-QA artifacts (scripts + docs tracked; generated artifacts ignored)
.tmp/render/
.tmp/media/
.tmp/*.png
.tmp/*.pptx
# runtime marker written by the tmp-review session hook
.tmp/.last-review-nudge


#..
*/.bak/
docs/seminar9-dbt/.bak/*.*
docs/seminar9-dbt/.bak/build_deck_v2.py

# Build artefact of the editable `src/preza_gen` install — regenerated by `just sync`.
src/*.egg-info/

# Project-local SYMLINK port of the canonical skills catalog (absolute, machine-specific
# paths → not portable across clones). The HARDLINK port in .claude/skills/ IS tracked.
# Recreate with: bash ~/.ai/skills/_catalog/docs/pptx/create-preza-about-de-tool/scripts/port-skill-local.sh
.claude/skills-canonical/
.gitsecret/keys/random_seed
!*.secret
.superpowers/

# Native Claude Code worktrees (EnterWorktree) — per-session isolation, never committed.
.claude/worktrees/

# agent-session-lock runtime files (session-lock hooks)
.ai/.locks/
